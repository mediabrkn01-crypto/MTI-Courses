# MTI Courses — Environment Variables
# Copy to .env for local development. NEVER commit .env to Git.
# Add .env to .gitignore.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Public/anon key — safe for frontend (subject to RLS)
SUPABASE_URL=https://rbhxufnfzsmkzenqavmf.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service-role key — SERVER-SIDE ONLY. Never expose in frontend or Git.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── Admin Bootstrap (scripts/bootstrap-admin.js) ────────────────────────────
# Use once to create the admin account. Never commit real values.
ADMIN_EMAIL=your_admin@example.com
ADMIN_PASSWORD=YourStrongPassword123!

# ─── Edge Function Secrets (set via: supabase secrets set KEY=value) ─────────
# These are set in Supabase Edge Function secrets — NOT in frontend code or Git.

# ElevenLabs API key — server-side only
# supabase secrets set ELEVENLABS_API_KEY=sk_xxxx
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxx

# Allowed CORS origin for Edge Functions
# supabase secrets set APP_ORIGIN=https://academy.brokenenglish.in
APP_ORIGIN=https://academy.brokenenglish.in

# Bunny Stream (for video-playback Edge Function — not yet implemented)
# supabase secrets set BUNNY_API_KEY=xxxx
# supabase secrets set BUNNY_LIBRARY_ID=xxxx
# supabase secrets set BUNNY_SIGNING_SECRET=xxxx
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_SIGNING_SECRET=
